{
  "name": "contextual-ad-agent",
  "version": "0.1.0",
  "description": "Video ad-bridging multi-agent system: analyzes a short-drama Episode + ad assets and generates a bridge (video / playable / CTA card) appended to the episode.",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "yarn@1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --inspect --exec tsx src/app.ts",
    "start": "cross-env NODE_ENV=prod node data/serve/app.js",
    "lint": "tsc --noEmit",
    "build": "cross-env NODE_ENV=prod tsx scripts/build.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/deepseek": "^2.0.17",
    "@ai-sdk/devtools": "^0.0.11",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.25",
    "@ai-sdk/openai-compatible": "^2.0.27",
    "@ai-sdk/xai": "^3.0.47",
    "@huggingface/transformers": "^3.8.1",
    "@rmp135/sql-ts": "^2.2.0",
    "ai": "^6.0.67",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-ws": "^5.0.2",
    "fast-glob": "^3.3.3",
    "form-data": "^4.0.5",
    "is-path-inside": "^4.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.5",
    "morgan": "^1.10.1",
    "p-limit": "^7.3.0",
    "qwen-ai-provider-v5": "^2.1.0",
    "serialize-error": "^13.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "sqlite3": "^6.0.1",
    "sucrase": "^3.35.1",
    "uuid": "^13.0.0",
    "vercel-minimax-ai-provider": "^0.0.2",
    "vm2": "^3.10.5",
    "wavefile": "^11.0.0",
    "zhipu-ai-provider": "^0.2.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.0",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@rmp135/sql-ts": {
      "better-sqlite3": "^12.8.0"
    }
  }
