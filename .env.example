# 复制这个文件为 .env，把值填成自己的真实 key，启动时(yarn dev / node data/serve/app.js)
# 会自动同步进 o_vendorConfig 并启用对应供应商，不用再手动跑 curl。
#
# 只有这里非空的字段才会被同步；留空/不写这一行就不会动数据库里已有的配置。
# apiKey 每次都会被 .env 里的值覆盖——也就是说 .env 是"最终来源"，改了这里下次启动就生效。

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://napi.moretoken.ai/v1

IMAROUTER_API_KEY=
IMAROUTER_BASE_URL=https://api.imarouter.com

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# grsai 中转的 nano-banana 系列（Gemini 图片模型），gpt-image-2 中转不稳定时的备选图片生成供应商
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn
